load("@bazel_skylib//rules/directory:directory.bzl", "directory")
load("@bazel_skylib//rules/directory:subdirectory.bzl", "subdirectory")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//cargo_env:cargo_env.bzl", "cargo_env", "env_wrapper")

directory(
    name = "test_directory_root",
    srcs = ["testdata/directory/sentinel.txt"],
)

# This source directory target covers a subdirectory of the package-root target.
subdirectory(
    name = "test_directory",
    parent = ":test_directory_root",
    path = "testdata/directory",
)

genrule(
    name = "generated_sentinel",
    outs = ["generated/sentinel.txt"],
    cmd = "echo 'generated directory sentinel' > $@",
)

# Keep these files out of env_directories and include_directories so the tests
# verify env_files makes each file available in the wrapper's runfiles.
genrule(
    name = "env_file_generated",
    outs = ["env_files_generated/only_env_file.txt"],
    cmd = "echo 'generated env file sentinel' > $@",
)

directory(
    name = "generated_directory_root",
    srcs = [":generated_sentinel"],
)

subdirectory(
    name = "generated_directory",
    parent = ":generated_directory_root",
    path = "generated",
)

# This generated file is available only through filegroup_files' runfiles.
# It must be built and propagated even though it is absent from that target's files.
genrule(
    name = "directory_runtime_sentinel",
    outs = ["runtime_only/sentinel.txt"],
    cmd = "echo 'directory runtime sentinel' > $@",
)

filegroup(
    name = "filegroup_files",
    srcs = ["testdata/filegroup/sentinel.txt"],
    data = [":directory_runtime_sentinel"],
)

cargo_env(
    name = "env_under_test",
    env = {
        "CUSTOM_LITERAL": "cost $5, \"double quotes\", and 'single quotes'",
    },
    env_directories = {
        "CUSTOM_DIRECTORY": ":test_directory",
        "FILEGROUP_ROOT": ":filegroup_files",
        "GENERATED_DIRECTORY": ":generated_directory",
        "SOURCE_DIRECTORY": ":test_directory_root",
    },
    env_files = {
        "GENERATED_FILE": ":env_file_generated",
        "SOURCE_FILE": "testdata/env_files_source.txt",
    },
    include_directories = [
        ":generated_directory",
        ":test_directory",
        ":test_directory_root",
    ],
)

sh_test(
    name = "cargo_env_test",
    srcs = ["cargo_env_test.sh"],
    args = ["$(rlocationpath :env_under_test)"],
    data = [":env_under_test"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

sh_binary(
    name = "env_wrapper_probe",
    srcs = ["env_wrapper_probe.sh"],
)

env_wrapper(
    name = "env_wrapper_under_test",
    binary = ":env_wrapper_probe",
    environment = ":env_under_test",
)

sh_test(
    name = "env_wrapper_test",
    srcs = ["env_wrapper_test.sh"],
    args = ["$(rlocationpath :env_wrapper_under_test)"],
    data = [":env_wrapper_under_test"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)
